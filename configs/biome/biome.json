{
  "$schema": "https://biomejs.dev/schemas/2.5.8/schema.json",
  "root": false,
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "includes": [
      "**",
      "!!**/.next",
      "!!**/.turbo",
      "!!**/node_modules",
      "!!**/next-env.d.ts",
      "!!**/out",
      "!!**/cdk.out",
      "!!**/public/mockServiceWorker.js"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "all"
    },
    "domains": {
      "drizzle": "none",
      "react": "all",
      "reactNative": "none",
      "test": "all",
      "solid": "none",
      "next": "all",
      "qwik": "none",
      "svelte": "none",
      "vue": "none",
      "project": "none",
      "tailwind": "all",
      "turborepo": "all",
      "playwright": "none",
      "types": "none"
    }
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "single",
      "semicolons": "asNeeded"
    }
  },
  "css": {
    "parser": {
      "tailwindDirectives": true
    }
  },
  "overrides": [
    {
      "includes": ["apps/web/src/components/ui/**"],
      "linter": {
        "rules": {
          "a11y": {
            "noLabelWithoutControl": "off"
          }
        }
      }
    }
  ]
}
