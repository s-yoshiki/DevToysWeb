{
  "name": "devtoys-web",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "typecheck": "turbo run typecheck",
    "lint": "oxlint .",
    "lint:fix": "oxlint --fix .",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "test": "turbo run test",
    "check": "pnpm lint && pnpm format:check && pnpm typecheck",
    "check:fix": "pnpm lint:fix && pnpm format",
    "verify": "pnpm check && pnpm test",
    "deploy": "pnpm --filter @repo/infra deploy",
    "start": "turbo run start"
  },
  "devDependencies": {
    "esbuild": "^0.28.2",
    "oxfmt": "catalog:",
    "oxlint": "catalog:",
    "turbo": "catalog:"
  },
  "engines": {
    "node": ">=26.0.0 <27.0.0"
  },
  "packageManager": "pnpm@12.20.0"
}
